        "filter": "\\&{2,}|\\#{2,}|\\@{2,}|\\${2,}|~{2,}|\\*{2,}|\\[\\]|\\(\\)|\\{\\}",
        "to": "",
        "enable": true,
        "group": "symbols"
    },
    {
        "name": "http...",
